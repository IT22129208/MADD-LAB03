<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <EditText
        android:id="@+id/etNumber1"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginTop="72dp"
        android:background="@drawable/edit_text_bg"
        android:hint="@string/hint_number_1"
        android:importantForAutofill="no"
        android:inputType="numberDecimal|numberSigned"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/input_text"
        android:textColorHint="@color/input_hint"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/etNumber2"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/edit_text_bg"
        android:hint="@string/hint_number_2"
        android:importantForAutofill="no"
        android:inputType="numberDecimal|numberSigned"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/input_text"
        android:textColorHint="@color/input_hint"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etNumber1" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnPlus"
        android:layout_width="92dp"
        android:layout_height="92dp"
        android:layout_marginTop="56dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/btn_calc_bg"
        android:text="@string/op_add"
        android:textColor="@color/button_text"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/btnMinus"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etNumber2" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnMinus"
        android:layout_width="92dp"
        android:layout_height="92dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/btn_calc_bg"
        android:text="@string/op_sub"
        android:textColor="@color/button_text"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnPlus"
        app:layout_constraintTop_toTopOf="@id/btnPlus" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnMultiply"
        android:layout_width="92dp"
        android:layout_height="92dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/btn_calc_bg"
        android:text="@string/op_mul"
        android:textColor="@color/button_text"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/btnPlus"
        app:layout_constraintTop_toBottomOf="@id/btnPlus" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnDivide"
        android:layout_width="92dp"
        android:layout_height="92dp"
        android:background="@drawable/btn_calc_bg"
        android:text="@string/op_div"
        android:textColor="@color/button_text"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/btnMinus"
        app:layout_constraintTop_toTopOf="@id/btnMultiply" />

</androidx.constraintlayout.widget.ConstraintLayout>
